{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-prof/types/**/*.ts",
    ".next-prof/dev/types/**/*.ts",
    ".next-ta/types/**/*.ts",
    ".next-ta/dev/types/**/*.ts",
    ".next-student/types/**/*.ts",
    ".next-student/dev/types/**/*.ts",
    ".next-prof-1/types/**/*.ts",
    ".next-prof-1/dev/types/**/*.ts",
    ".next-prof-2/types/**/*.ts",
    ".next-prof-2/dev/types/**/*.ts",
    ".next-prof-3/types/**/*.ts",
    ".next-prof-3/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".next-prof", ".next-ta", ".next-student"]
}
